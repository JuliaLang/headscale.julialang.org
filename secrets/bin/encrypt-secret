#!/usr/bin/env bash

# shellcheck source-path=SCRIPTDIR

set -euo pipefail

# Load utilities
source "$(dirname -- "${BASH_SOURCE[0]}")/age-utils.sh"

# File to encrypt
file=$(arg_or_prompt "Input file to encrypt" "${1:-}")
require_plain_file "${file}"

# Require the target file to not exist (i.e. --no-clobber)
if [[ -f "${file}.age" ]]; then
    echo "Output file '${file}.age' exists, exiting."
    exit 1
fi

# Encrypt it
encage -o "${file}.age" "${file}"
