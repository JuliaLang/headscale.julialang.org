#!/usr/bin/env bash

# shellcheck source-path=SCRIPTDIR

set -euo pipefail

# Load utilities
source "$(dirname -- "${BASH_SOURCE[0]}")/age-utils.sh"

# Input file to decrypt
agefile=$(arg_or_prompt "Input file to decrypt (.age)" "${1:-}")
require_age_file "${agefile}"

# Output file to decrypt to
file=${2:-${agefile%.age}}

# Require input to be ${file}.age
# TODO: This is a bit silly but...
if [[ "${agefile%.age}" != "${file}" ]]; then
    echo "Output file must equal input file without the .age extension, exiting."
    exit 1
fi

# Handle existing output file. If the file exist, and the content match, we
# strip write bits (the .age file is the source of truth — don't edit in
# place), copy the timestamp from the encrypted file to make make happy, and
# exit cleanly. If the file exist and content do not match we error out
# (i.e. --no-clobber).
if [[ -f "${file}" ]]; then
    if [[ "$(sha256sum <"${file}")" == "$(decage "${agefile}" | sha256sum)" ]]; then
        chmod a-w "${file}"
        touch --reference="${agefile}" "${file}"
        exit 0
    else
        echo "Output file '${file}' exist with other content, exiting."
        exit 1
    fi
fi

# Decrypt it. Fresh files are created 0400 (owner read only) as a secure
# default; the fast path above preserves any wider read bits the caller sets
# on subsequent runs.
(umask 277 && decage -o "${file}" "${agefile}")
