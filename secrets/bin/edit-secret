#!/usr/bin/env bash

# shellcheck source-path=SCRIPTDIR

set -euo pipefail

# Load utilities
source "$(dirname -- "${BASH_SOURCE[0]}")/age-utils.sh"

# File to update
agefile=$(arg_or_prompt "Input file to update (.age)" "${1:-}")
require_age_file "${agefile}"

# Compute the sha256 of the content to compare with
encrypted_sha256=$(decage "${agefile}" | sha256sum)

# If the corresponding decrypted file exist we verify that it hasn't diverged
# from the encrypted file which should be the source of truth
file=${agefile%.age}
if [[ -f "${file}" ]] && [[ "$(sha256sum <"${file}")" != "${encrypted_sha256}" ]]; then
    echo "File '${file}' exists but the content do not match the encrypted file, exiting."
    exit 1
fi

# Create a temporary file to decrypt to and register cleanup for it and the
# re-encrypted temp file that may be created further down.
tmpfile=$(umask 077 && mktemp "${file}.XXXXXXXX")
trap 'rm -f "${tmpfile}" "${tmpfile}.age"' EXIT

# Decrypt to temp file
decage -o "${tmpfile}" "${agefile}"

# Edit it
"${VISUAL:-${EDITOR:-vim}}" "${tmpfile}"

# Check if changes were made
if [[ "$(sha256sum <"${tmpfile}")" == "${encrypted_sha256}" ]]; then
    exit 0
fi

# Reencrypt to temporary age file
encage -o "${tmpfile}.age" "${tmpfile}"

# Atomically replace the outdated encrypted file with the new one
mv -f "${tmpfile}.age" "${agefile}"

# If the decrypted file exist we make sure it is updated as well. We do this by
# simply renaming tmpfile since it already contains the correct data. Also copy
# the timestamp from the newly encrypted file to make make happy.
if [[ -f "${file}" ]]; then
    chmod --reference="${file}" "${tmpfile}"
    mv -f "${tmpfile}" "${file}"
    chmod a-w "${file}"
    touch --reference="${agefile}" "${file}"
fi
